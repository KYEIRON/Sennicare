# =============================================================================
# BOYD'S Logistics LLC — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
#
# The application starts successfully without the OPTIONAL variables below.
# Any capability whose credentials are missing reports itself as UNAVAILABLE
# in the application rather than pretending to work.
# =============================================================================

# --- Application ------------------------------------------------------------
# The public URL of the site. Used for canonical URLs, the sitemap, and
# Open Graph tags. In local development this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database and authentication (REQUIRED) ---------------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser. Never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- BOYD'S AI (OPTIONAL — Phase 11) ----------------------------------------
# Without these, the AI receptionist and internal assistant show as unavailable.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Maps (OPTIONAL — Phase 13) ---------------------------------------------
# Without these, mileage is entered manually and vehicle location shows
# "Live tracking unavailable". Nothing is simulated.
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Email (OPTIONAL — Phase 13) --------------------------------------------
# Without these, outbound messages are queued as notifications for a partner
# to send manually. Nothing reports "sent" when nothing was sent.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- SMS (OPTIONAL — Phase 13) ----------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
